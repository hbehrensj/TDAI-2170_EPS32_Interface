// Copy this file to "secrets.h" (same folder) and fill in your WiFi for
// direct bring-up. secrets.h is gitignored and never committed.
//
// If WIFI_SSID is left empty, the firmware uses the WiFiManager captive
// portal instead. Holding the BOOT button at boot always forces the portal,
// even when these are set.
#pragma once

#define WIFI_SSID ""   // e.g. "esp-test"  (your iPhone hotspot, 2.4 GHz)
#define WIFI_PASS ""   // hotspot password
